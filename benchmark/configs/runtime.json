{
  "model": "gpt-4o-mini",
  "env_file": ".env",
  "seed": 17,
  "top_k": 100,
  "reader_token_budget": null,
  "reader_tokenizer": "o200k_base",
  "answer_input_token_limit": 117760,
  "answer_temperature": 0,
  "judge_temperature": 0,
  "answer_max_tokens": 8192,
  "judge_max_tokens": 16384,
  "memory_default_max_tokens": 2048,
  "request_timeout_seconds": 45,
  "worker_timeout_seconds": 1800,
  "rates_cny_per_million": {
    "input": 0.15,
    "output": 0.6,
    "embedding": 0.5
  },
  "price_source": "user-provided historical rates; estimates, not provider billing",
  "context_policy": "AML ranked evidence prefix; complete prompt <=117760 tokens; output 8192; safety 2048",
  "lifecycle": "offline-history-QA: chronological sessions, native finalize, queries",
  "naive_timestamp_timezone": "UTC",
  "answer_output_policy": "fixed_aml_budget",
  "judge_output_policy": "model_maximum",
  "answer_context_policy": "aml_ranked_prefix_v1",
  "answer_part_truncation_policy": null,
  "clbench_judge_protocol": "clbench-indexed-status-v2",
  "judge_protocol_max_attempts": 3,
  "persist_answer_responses": true,
  "provider_error_diagnostics": true,
  "add_chunk_policy": "aml_20_messages_2000_words_v1",
  "max_retries": 10,
  "answer_safety_margin_tokens": 2048
}
