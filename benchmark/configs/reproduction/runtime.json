{
  "model": "gpt-4o-mini",
  "env_file": ".env",
  "seed": 17,
  "top_k": 100,
  "reader_token_budget": 4096,
  "reader_tokenizer": "o200k_base",
  "answer_input_token_limit": 119000,
  "answer_temperature": 0,
  "judge_temperature": 0,
  "answer_max_tokens": null,
  "judge_max_tokens": 16384,
  "memory_default_max_tokens": 2048,
  "request_timeout_seconds": 180,
  "worker_timeout_seconds": 86400,
  "rates_cny_per_million": {
    "input": 0.15,
    "output": 0.6,
    "embedding": 0.5
  },
  "price_source": "user-provided historical rates; estimates, not provider billing",
  "context_policy": "ranked whole evidence; skip overflowing items; preserve retained order",
  "lifecycle": "offline-history-QA: chronological sessions, native finalize, queries",
  "naive_timestamp_timezone": "UTC",
  "answer_output_policy": "model_maximum",
  "judge_output_policy": "model_maximum"
}
