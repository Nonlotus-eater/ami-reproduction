# Copy to .env and enter credentials locally. Never commit the filled file.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AMI_LLM_MODEL=gpt-4o-mini
# AMI, Mem0 and InvMem use this shared embedding API; ReFind uses native BM25.
AMI_EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AMI_EMBED_API_KEY=
AMI_EMBED_MODEL=text-embedding-v4
# Dimensions and batch size apply to every baseline; use new indexes after changes.
AMI_EMBED_DIMENSIONS=1024
AMI_EMBED_BATCH=10
AMI_EMBED_BACKEND=openai
AMI_REPRO_EMBED_PROTOCOL=openai
# Use the HTTPS OpenAI-compatible endpoint from your Model Studio workspace.
# Beijing example (replace WorkspaceId before use):
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Singapore example (replace WorkspaceId before use):
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Existing account endpoints may differ; do not overwrite a working endpoint blindly.
